{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "900000"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ]; then bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-setup.sh\"; fi",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run verify)",
      "Bash(npm run verify:fast)",
      "Bash(npm run verify:no-docs)",
      "Bash(npm run test:changed)",
      "Bash(npm run test:node)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test-vault:check)",
      "Bash(npm run check:layers)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc -noEmit -skipLibCheck)",
      "Bash(node scripts/check-layers.mjs)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
